#!/usr/bin/env python3
"""Entry point for the agenttalk CLI. Symlink this into a directory on PATH."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(HERE))

from agenttalk.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
